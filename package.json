{
  "name": "flightdeck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Flightdeck",
  "description": "Local-first AWS and GitHub Actions control panel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3325",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3325",
    "start:standalone": "cross-env PORT=3325 node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "electron:dev": "concurrently -k \"next dev -p 3325\" \"wait-on http://127.0.0.1:3325 && cross-env FLIGHTDECK_ELECTRON_DEV=1 electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "^3.1127.0",
    "@aws-sdk/client-amplify": "^3.1127.0",
    "@aws-sdk/client-cloudtrail": "^3.1127.0",
    "@aws-sdk/client-iam": "^3.1127.0",
    "@aws-sdk/client-route-53": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/credential-providers": "^3.1127.0",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-popover": "^1.1.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "libsodium-wrappers": "^0.8.4",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.flightdeck.app",
    "productName": "Flightdeck",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github"
    }
  }
}
