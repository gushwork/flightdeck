# Copy to .env.local and fill in. Do not commit real secrets.

# Optional: app Postgres cache (secrets list TTL)
# DATABASE_URL=postgres://user:pass@localhost:5432/flightdeck_cache

# AWS / UI
# NEXT_PUBLIC_AWS_PROFILES=

# Azure self-hosted GitHub runner page (/github/runner) — SSH via `az ssh` (Entra ID), no password.
# Needs `az login`, the az ssh extension (`az extension add --name ssh`), the AADSSHLoginForLinux VM extension,
# and the "Virtual Machine Administrator Login" role on the VM (sudo to the runner user).
# Put these in .env.azure (gitignored) or .env.local. Host/user can also be set in Settings → Runner VM (that wins over these).
# A host is required from one of the two; user (account the runner runs under) defaults to azureuser.
# RUNNER_VM_HOST=<vm ip or hostname>
# RUNNER_VM_USER=azureuser

# Cloud spend page (/costs) — Google Cloud spend comes from the Cloud Billing export to BigQuery, read with `bq`.
# Enable it in Billing → Billing export → BigQuery export (standard usage cost), then set the dataset here
# (every gcp_billing_export_v1_* table in it is summed; use project.dataset.table to pin one).
# GCP_BILLING_EXPORT=my-project.billing_export
