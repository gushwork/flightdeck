# Copy to .env.local and fill in. Do not commit real secrets.

# Optional: app Postgres cache (secrets list TTL)
# DATABASE_URL=postgres://user:pass@localhost:5432/flightdeck_cache

# AWS / UI
# NEXT_PUBLIC_AWS_PROFILES=

# Azure self-hosted GitHub runner page (/github/runner) — SSH over password auth.
# Put these in .env.azure (gitignored) or .env.local. Host/user can also be set in Settings → Runner VM (that wins over these).
# A host is required from one of the two; user defaults to azureuser.
# RUNNER_VM_HOST=<vm ip or hostname>
# RUNNER_VM_USER=azureuser
# VM_PASSWORD=
